<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- La revisión periódica de alertas sobrevive a los reinicios -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Inventario">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustNothing" />

        <!-- Un alias por icono: solo uno está activo y es el que muestra el lanzador -->
        <activity-alias
            android:name=".IconClasico"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconNoche"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_noche"
            android:roundIcon="@mipmap/ic_launcher_noche"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconLabial"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_labial"
            android:roundIcon="@mipmap/ic_launcher_labial"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity android:name=".ProductActivity" android:exported="false" />
        <activity android:name=".EditProductActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".CategoriesActivity" android:exported="false" />

        <!-- Solo entrega a la app de cámara el archivo temporal donde guarda la foto -->
        <provider
            android:name=".PhotoProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Widget de pantalla de inicio: por reponer y por vencer -->
        <receiver
            android:name=".InventoryWidget"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <service
            android:name=".AlertJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
