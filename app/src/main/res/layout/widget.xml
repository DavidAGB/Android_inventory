<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="3 por reponer · 1 por vencer"
                android:textColor="@color/muted"
                android:textSize="12.5sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_add"
            android:contentDescription="Nuevo producto"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="+"
            android:textColor="@color/on_accent"
            android:textSize="22sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:background="@color/line" />

    <LinearLayout
        android:id="@+id/row0"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="visible">
        <TextView
            android:id="@+id/dot0"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="@color/danger"
            android:textSize="9sp" />
        <TextView
            android:id="@+id/name0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Base Fit Me"
            android:textColor="@color/ink"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/detail0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:text="Agotado"
            android:textColor="@color/danger"
            android:textSize="12.5sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="visible">
        <TextView
            android:id="@+id/dot1"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="@color/warn"
            android:textSize="9sp" />
        <TextView
            android:id="@+id/name1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Rubor"
            android:textColor="@color/ink"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/detail1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:text="Quedan 1"
            android:textColor="@color/warn"
            android:textSize="12.5sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="visible">
        <TextView
            android:id="@+id/dot2"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="@color/warn"
            android:textSize="9sp" />
        <TextView
            android:id="@+id/name2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Crema hidratante"
            android:textColor="@color/ink"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/detail2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:text="Quedan 1"
            android:textColor="@color/warn"
            android:textSize="12.5sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row3"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="visible">
        <TextView
            android:id="@+id/dot3"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="@color/warn"
            android:textSize="9sp" />
        <TextView
            android:id="@+id/name3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Sérum vitamina C"
            android:textColor="@color/ink"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/detail3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:text="Vence en 4 días"
            android:textColor="@color/warn"
            android:textSize="12.5sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row4"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/dot4"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="@color/warn"
            android:textSize="9sp" />
        <TextView
            android:id="@+id/name4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/ink"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/detail4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/warn"
            android:textSize="12.5sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row5"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/dot5"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="@color/warn"
            android:textSize="9sp" />
        <TextView
            android:id="@+id/name5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/ink"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/detail5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/warn"
            android:textSize="12.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
